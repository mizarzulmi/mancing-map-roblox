local byId: { [string]: FishSpecies } = {}
for i, s in list do
	assert(byId[s.Id] == nil, "Id ikan ganda: " .. s.Id)
	assert(s.MinWeight > 0 and s.MaxWeight >= s.MinWeight, "Berat tidak valid: " .. s.Id)
	byId[s.Id] = s
	list[i] = s
end

local Fish = {}
Fish.List = list
Fish.ById = byId

function Fish.Get(id: string): FishSpecies?
	return byId[id]
end

-- Daftar spesies yang mungkin muncul di zona tertentu (tanpa memeriksa waktu/cuaca).
function Fish.InZone(zoneId: string): { FishSpecies }
	local out = {}
	for _, s in list do
		if table.find(s.Zones, zoneId) then
			table.insert(out, s)
		end
	end
	return out
end

return Fish
