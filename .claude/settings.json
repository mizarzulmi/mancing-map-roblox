{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["Roblox_Studio"],
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git show:*)",
      "Bash(bash scripts/api.sh:*)",
      "Bash(python scripts/studio_mcp.py:*)",
      "Bash(python -I scripts/studio_mcp.py:*)",
      "Bash(./.tools/bin/lune.exe run:*)",
      "Bash(./.tools/bin/rojo.exe sourcemap:*)",
      "Bash(./.tools/bin/rojo.exe build:*)",
      "Bash(./.tools/bin/luau-lsp.exe analyze:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1:*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1:*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1:*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1:*)",
      "mcp__Roblox_Studio__list_roblox_studios",
      "mcp__Roblox_Studio__get_studio_state",
      "mcp__Roblox_Studio__search_game_tree",
      "mcp__Roblox_Studio__inspect_instance",
      "mcp__Roblox_Studio__script_search",
      "mcp__Roblox_Studio__script_grep",
      "mcp__Roblox_Studio__script_read",
      "mcp__Roblox_Studio__get_console_output",
      "mcp__Roblox_Studio__screen_capture",
      "mcp__Roblox_Studio__start_stop_play",
      "mcp__Roblox_Studio__character_navigation",
      "mcp__Roblox_Studio__user_keyboard_input",
      "mcp__Roblox_Studio__user_mouse_input",
      "mcp__Roblox_Studio__execute_luau",
      "mcp__Roblox_Studio__search_asset"
    ],
    "ask": [
      "mcp__Roblox_Studio__insert_asset",
      "mcp__Roblox_Studio__generate_mesh"
    ],
    "deny": [
      "mcp__Roblox_Studio__multi_edit"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/session-start.mjs", "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__Roblox_Studio__.*",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/guard-studio.mjs", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/luau-check.mjs", "timeout": 90 }]
      },
      {
        "matcher": "mcp__Roblox_Studio__insert_asset|mcp__Roblox_Studio__generate_mesh",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/asset-reminder.mjs", "timeout": 10 }]
      }
    ]
  }
}
